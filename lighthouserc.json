{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Server listening",
      "url": ["http://localhost:4321/", "http://localhost:4321/404"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562,
          "downloadThroughputKbps": 1474,
          "uploadThroughputKbps": 675
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 92160 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 20480 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 81920 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 921600 }],
        "resource-summary:total:count": ["error", { "maxNumericValue": 35 }],

        "unused-javascript": ["warn", { "maxLength": 0 }],
        "modern-image-formats": ["error", { "maxLength": 0 }],
        "uses-responsive-images": ["error", { "maxLength": 0 }],
        "unsized-images": ["error", { "maxLength": 0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
