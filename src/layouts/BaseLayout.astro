---
import '~/styles/global.css';
import { siteConfig } from '~/config/site';
import { resolveSeo, type SeoProps } from '~/lib/seo';
import { buildJsonLd, organizationSchema, websiteSchema } from '~/lib/schema-ld';
import SiteHeader from '~/components/layout/SiteHeader.astro';
import SiteFooter from '~/components/layout/SiteFooter.astro';

type Props = SeoProps & {
  /** JSON-LD tambahan khusus halaman ini (Article, FAQPage, dst). */
  schemas?: Record<string, unknown>[];
};

const { schemas = [], ...seoProps } = Astro.props;
const seo = resolveSeo(seoProps);

// Organization + WebSite ada di setiap halaman; sisanya per halaman.
const jsonLd = buildJsonLd(organizationSchema(), websiteSchema(), ...schemas);
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />

    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={siteConfig.themeColor} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    {/*
      Anti-flash: harus inline dan sinkron, sebelum paint pertama.
      Memuatnya sebagai modul eksternal membuat halaman berkedip putih
      dulu sebelum tema gelap ter-apply.
    */}
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {
          /* localStorage diblokir — tetap pakai tema terang */
        }
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">Lewati ke konten utama</a>

    <SiteHeader />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter />

    <script>
      // Scroll reveal — satu observer untuk seluruh halaman.
      const els = document.querySelectorAll<HTMLElement>('.reveal');

      if (els.length > 0) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -10% 0px' },
          );
          els.forEach((el) => io.observe(el));
        } else {
          // Browser lama: tampilkan semuanya, jangan sembunyikan konten.
          els.forEach((el) => el.classList.add('is-visible'));
        }
      }
    </script>
  </body>
</html>
