---
import { siteConfig } from '~/config/site';

const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--surface-border);">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <p class="text-base font-semibold">{siteConfig.name}</p>
        <p class="mt-2 text-sm" style="color: var(--text-muted);">
          {siteConfig.description}
        </p>
      </div>

      <nav aria-label="Navigasi footer">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-1 text-sm sm:grid-cols-3">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="inline-flex h-11 items-center hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
      style="border-color: var(--surface-border); color: var(--text-muted);"
    >
      <p>&copy; {year} {siteConfig.name}. Seluruh hak cipta dilindungi.</p>
      <ul class="flex gap-4">
        <li><a href="/kebijakan-privasi" class="hover:underline">Kebijakan Privasi</a></li>
        <li><a href="/syarat-ketentuan" class="hover:underline">Syarat &amp; Ketentuan</a></li>
      </ul>
    </div>
  </div>
</footer>
