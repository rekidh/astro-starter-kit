---
import { siteConfig } from '~/config/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  class="sticky top-0 z-30 border-b backdrop-blur"
  style="border-color: var(--surface-border); background-color: color-mix(in oklab, var(--surface) 85%, transparent);"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="text-lg font-semibold tracking-tight">
      {siteConfig.name}
    </a>

    <nav aria-label="Navigasi utama" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class="inline-flex h-11 items-center rounded-md px-3 text-sm font-medium transition-colors hover:bg-brand-50 aria-[current=page]:text-brand-700 dark:hover:bg-brand-950/40 dark:aria-[current=page]:text-brand-300"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />

      <button
        type="button"
        id="mobile-nav-toggle"
        class="inline-flex size-11 items-center justify-center rounded-md md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Buka menu navigasi"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-5"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Navigasi utama (mobile)"
    hidden
    class="border-t md:hidden"
    style="border-color: var(--surface-border);"
  >
    <ul class="mx-auto max-w-6xl px-4 py-2">
      {
        siteConfig.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class="flex h-11 items-center rounded-md px-3 text-sm font-medium aria-[current=page]:text-brand-700 dark:aria-[current=page]:text-brand-300"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Buka menu navigasi' : 'Tutup menu navigasi');
      nav.hidden = open;
    });

    // Esc menutup menu dan mengembalikan fokus ke tombol.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || nav.hidden) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Buka menu navigasi');
      nav.hidden = true;
      toggle.focus();
    });
  }
</script>
