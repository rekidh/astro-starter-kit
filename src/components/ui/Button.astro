---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '~/lib/utils';
import type { HTMLAttributes } from 'astro/types';

const button = cva(
  'inline-flex items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap transition-colors disabled:pointer-events-none disabled:opacity-50',
  {
    variants: {
      variant: {
        primary: 'bg-brand-600 text-white hover:bg-brand-700',
        secondary: 'bg-brand-50 text-brand-800 hover:bg-brand-100 dark:bg-brand-950 dark:text-brand-200',
        outline: 'border border-current/20 hover:bg-brand-50 dark:hover:bg-brand-950/40',
        ghost: 'hover:bg-brand-50 dark:hover:bg-brand-950/40',
      },
      // Tinggi minimal 44px (size md) memenuhi target sentuh WCAG 2.5.5.
      size: {
        sm: 'h-9 px-3 text-sm',
        md: 'h-11 px-5 text-sm',
        lg: 'h-12 px-7 text-base',
      },
    },
    defaultVariants: { variant: 'primary', size: 'md' },
  },
);

type Props = VariantProps<typeof button> &
  Omit<HTMLAttributes<'button'>, 'type'> & {
    href?: string;
    type?: 'button' | 'submit' | 'reset';
  };

const { variant, size, href, class: className, type = 'button', ...rest } = Astro.props;
const classes = cn(button({ variant, size }), className);
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
