---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '~/lib/utils';
import type { HTMLAttributes } from 'astro/types';

const badge = cva(
  'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium whitespace-nowrap',
  {
    variants: {
      variant: {
        default: 'bg-brand-50 text-brand-800 dark:bg-brand-950 dark:text-brand-200',
        outline: 'border border-current/20',
        success: 'bg-success/10 text-success',
        warning: 'bg-warning/10 text-warning',
        danger: 'bg-danger/10 text-danger',
      },
    },
    defaultVariants: { variant: 'default' },
  },
);

type Props = VariantProps<typeof badge> & HTMLAttributes<'span'>;

const { variant, class: className, ...rest } = Astro.props;
---

<span class={cn(badge({ variant }), className)} {...rest}>
  <slot />
</span>
