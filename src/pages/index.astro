---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroSection from '~/components/sections/HeroSection.astro';
import Card from '~/components/ui/Card.astro';
import Slider from '~/components/ui/Slider.astro';
import Badge from '~/components/ui/Badge.astro';

// Placeholder — struktur & urutan seksi menunggu konteks bisnis Arebi.
const demoSlides = [1, 2, 3, 4, 5, 6];
---

<BaseLayout path="/">
  <HeroSection />

  <section class="mx-auto max-w-6xl px-4 pb-20">
    <div class="reveal">
      <Badge>Scaffold</Badge>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight">Komponen yang sudah tersedia</h2>
      <p class="mt-2 max-w-2xl" style="color: var(--text-muted);">
        Halaman ini hanya demo primitif. Seksi sesungguhnya disusun setelah konteks bisnis
        Arebi masuk.
      </p>
    </div>

    <div class="reveal mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <Card as="article">
        <h3 class="font-medium">Design token</h3>
        <p class="mt-1 text-sm" style="color: var(--text-muted);">
          Warna, radius, dan easing terpusat di <code>global.css</code>.
        </p>
      </Card>
      <Card as="article">
        <h3 class="font-medium">SEO &amp; JSON-LD</h3>
        <p class="mt-1 text-sm" style="color: var(--text-muted);">
          Meta, canonical, OG, dan structured data dari satu sumber.
        </p>
      </Card>
      <Card as="article">
        <h3 class="font-medium">Dark mode</h3>
        <p class="mt-1 text-sm" style="color: var(--text-muted);">
          Toggle tanpa library, tanpa flash saat halaman dimuat.
        </p>
      </Card>
    </div>

    <div class="reveal mt-14">
      <h2 class="text-2xl font-semibold tracking-tight">Slider</h2>
      <p class="mt-2 text-sm" style="color: var(--text-muted);">
        Swiper Element, di-lazy load saat mendekati viewport. Sebelum itu tetap bisa
        di-scroll horizontal.
      </p>

      <Slider label="Contoh galeri" class="mt-5">
        {
          demoSlides.map((n) => (
            <swiper-slide style="width: 16rem;">
              <div
                class="flex h-44 items-center justify-center rounded-lg border text-sm"
                style="border-color: var(--surface-border); background-color: var(--surface-muted); color: var(--text-muted);"
              >
                Slide {n}
              </div>
            </swiper-slide>
          ))
        }
      </Slider>
    </div>
  </section>
</BaseLayout>
